# Contoh koneksi dari aplikasi di WSL ke MySQL XAMPP di Windows
# Ganti WINDOWS_HOST_IP dengan nilai: ip route | awk '/default/ {print $3}'
# Jika memakai WSL mirrored networking, DB_HOST=127.0.0.1 mungkin dapat digunakan.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=examlan_app
DB_PASSWORD=GANTI_PASSWORD_DATABASE
DB_NAME=examlan
TZ=Asia/Jakarta
APP_URL=http://localhost:3001
