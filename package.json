    "db:repair": "node scripts/repair-db.js",
    "admin:reset": "node scripts/reset-admin.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "backup:restore": "node scripts/restore-backup.js"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "mysql2": "^3.15.0",
    "bcryptjs": "^3.0.2",
    "docx": "^9.5.1",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.5.3",
    "dotenv": "^17.2.2",
    "exceljs": "^4.4.0",
    "yauzl": "^3.4.0",
    "fast-xml-parser": "^5.11.2"
  },
  "devDependencies": {
    "tailwindcss": "^4.3.3",
    "postcss": "^8.5.29",
    "autoprefixer": "^10.4.21",
    "@tailwindcss/postcss": "^4.3.3"
  },
  "overrides": {
    "postcss": "$postcss",
    "exceljs": {
      "uuid": "^11.1.1"
