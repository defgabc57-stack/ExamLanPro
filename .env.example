# ExamLAN dengan MySQL XAMPP Windows (port 3306) + Next.js (port 3001)
# Windows: 127.0.0.1. Jika npm berjalan di WSL2 NAT, gunakan IP host Windows.
DB_HOST=127.0.0.1
DB_PORT=3306
# XAMPP lokal sering menggunakan root tanpa password; sesuaikan dengan akun Anda.
# Untuk server LAN/produksi, buat akun khusus database dengan password kuat.
DB_USER=root
DB_PASSWORD=
DB_NAME=examlan
TZ=Asia/Jakarta
APP_URL=http://localhost:3001
